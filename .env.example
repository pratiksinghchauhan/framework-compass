# Copy this file to .env and fill in your values. .env is gitignored.
# Variables already set in your shell take priority over this file.

# Gemini API key, from Google AI Studio.
GEMINI_API_KEY=

# Gemini model that writes the answers.
LLM_MODEL=gemini-3.5-flash-lite

# Optional: a Hugging Face token gives higher rate limits when downloading the embedding model.
# HF_TOKEN=
